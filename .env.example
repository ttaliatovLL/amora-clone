# Amora — planned environment variables. NONE are used yet: the app runs fully mocked without a .env.
# Copy to .env.local and fill in as each integration lands (see docs/INTEGRATIONS.md).
# Server-only secrets: never prefix these with NEXT_PUBLIC_.

# 1. AI chat (any LLM provider)
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# 2. Auth
AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# 3. Persistence (Postgres, EU region)
DATABASE_URL=

# 4. Payments (high-risk processor or crypto gateway)
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# 5. Voice notes and 8. calls
ELEVENLABS_API_KEY=

# 6. Personalized photos and videos
HIGGSFIELD_API_KEY=
